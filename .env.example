# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wedding-platform?retryWrites=true&w=majority

# JWT Auth Secret (Minimum 32 random characters)
AUTH_SECRET=your_super_secret_jwt_encryption_key_min_32_chars

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application Base URL (for Open Graph and invitations URL generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
